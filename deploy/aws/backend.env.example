# Copy to deploy/aws/backend.env (./init-env.sh does this). Read by the API and the worker.
# DATABASE_URL is set in compose.yml from the passwords in .env. See backend/.env.example for
# what every setting means.
ENVIRONMENT=production
LOG_LEVEL=INFO

AUTH_JWKS_URL=https://app.ic.rgproject.me/api/auth/jwks
AUTH_ISSUER=https://app.ic.rgproject.me
EVENTS_ALLOWED_ORIGINS=https://app.ic.rgproject.me

# AWS S3 through the EC2 instance role. Do not add S3_ENDPOINT_URL, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY or S3_FORCE_PATH_STYLE, not even blank (a blank endpoint is not "unset").
S3_BUCKET=ic-uploads-CHANGE-ME
S3_REGION=ap-southeast-2

# WORKER_CONCURRENCY=2

# Language model: copy your LLM_* and *_API_KEY lines from backend/.env, then set real caps.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
LLM_FALLBACK_PROVIDER=none
LLM_SPEND_CAP_AUD=5
LLM_USD_TO_AUD=1.60
LLM_USER_SPEND_CAP_AUD=1
LLM_USAGE_LABEL=prod

# Same value as ADMIN_DASHBOARD_KEY in web.env (init-env.sh fills both). Blank: dashboard off.
ADMIN_DASHBOARD_KEY=
