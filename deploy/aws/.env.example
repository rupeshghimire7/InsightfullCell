# Copy to deploy/aws/.env (./init-env.sh does this and fills the blanks). Never commit the copy.
# Database passwords, used by compose.yml to build every connection URL. Hex only, because they
# go into URLs: openssl rand -hex 24
POSTGRES_PASSWORD=
IC_AUTH_DB_PASSWORD=
IC_APP_DB_PASSWORD=

# Where backup.sh uploads nightly database dumps (a bucket of its own, not the upload bucket).
BACKUP_BUCKET=

# Images (deploy.sh pulls them; built by .github/workflows/images.yml). Defaults shown.
# IC_IMAGE_PREFIX=ghcr.io/rupeshghimire7/insightfullcell
# IC_IMAGE_TAG=latest
