{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::ic-uploads-CHANGE-ME/*"
    },
    {
      "Sid": "UploadBucketListing",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::ic-uploads-CHANGE-ME"
    },
    {
      "Sid": "BackupsWriteOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::ic-backups-CHANGE-ME/ic/*"
    }
  ]
}
