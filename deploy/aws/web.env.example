# Copy to deploy/aws/web.env (./init-env.sh does this). Read by the web app.
# AUTH_DATABASE_URL is set in compose.yml from the passwords in .env. See frontend/.env.example
# for what every setting means.
APP_ENV=production

BETTER_AUTH_URL=https://app.ic.rgproject.me
# 32+ random characters (init-env.sh fills it). Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The API inside Docker for the server, and its public address for browsers.
API_BASE_URL=http://api:8000
API_PUBLIC_URL=https://api.ic.rgproject.me

# Where browsers upload file parts. It must match the host the API signs upload links for:
#   us-east-1:     https://<bucket>.s3.amazonaws.com          (no region in the host)
#   other regions: https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_ORIGIN=https://ic-uploads-CHANGE-ME.s3.ap-southeast-2.amazonaws.com

# Email sign-in links: off until a domain is verified at resend.com (README.md, step 13).
EMAIL_LINK_SIGN_IN=off
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# EMAIL_FROM="InsightfulCell <no-reply@ic.rgproject.me>"
# EMAIL_LINK_ALLOWED_EMAILS=

# Same value as ADMIN_DASHBOARD_KEY in backend.env (init-env.sh fills both). Blank: no /adminboard.
ADMIN_DASHBOARD_KEY=
ADMIN_SESSION_MINUTES=30

# Optional Google sign-in. Redirect URI: https://app.ic.rgproject.me/api/auth/callback/google
# Off (the default): the button is shown disabled. Set on, with both values below, to offer it.
GOOGLE_SIGN_IN=off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
