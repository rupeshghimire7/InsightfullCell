# Copy to frontend/.env.local (scripts/bootstrap.sh does this, with a fresh secret). Never commit it.
APP_ENV=local

# Public URL of this app. It is also the issuer of the tokens the API verifies.
BETTER_AUTH_URL=http://localhost:3000
# Other addresses the same app is opened at (an ngrok tunnel, a LAN address), comma separated.
# Sign-in refuses every other origin (403 Invalid origin). `make allow-origin ORIGIN=…` adds one
# here, to the API's EVENTS_ALLOWED_ORIGINS and to the bucket's CORS (SETUP_MANUAL.md, 1.1).
# AUTH_TRUSTED_ORIGINS=https://your-name.ngrok-free.app
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-32-or-more-random-characters

# The web app's own database role. It owns only the `auth` schema (created by `make migrate`).
AUTH_DATABASE_URL=postgresql://ic_auth:ic_auth_dev@localhost:5432/insightfulcell

# Where the Next.js server reaches the API, and where the browser reaches object storage.
API_BASE_URL=http://localhost:8000
S3_PUBLIC_ORIGIN=http://localhost:9000
# Where the *browser* reaches the API for live-progress streams (defaults to API_BASE_URL).
# API_PUBLIC_URL=https://api.your-domain.example
# AUTH_EVENTS_AUDIENCE=insightfulcell-events

# "Email me a sign-in link". On: console prints links to the terminal running `make web`;
# resend sends them (paste RESEND_API_KEY from resend.com/api-keys). Resend's test sender
# (onboarding@resend.dev) only delivers to the Resend account's own address, so put that address
# in EMAIL_LINK_ALLOWED_EMAILS: everyone else is told email sign-in is for testing and asked to
# register with a password. Blank list: anyone (fine with console). Off: the button is disabled.
EMAIL_LINK_SIGN_IN=on
EMAIL_TRANSPORT=console
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=re_…            (resend.com/api-keys)
EMAIL_FROM="InsightfulCell <onboarding@resend.dev>"
# The Resend account's email (the owner), comma separated for more than one.
EMAIL_LINK_ALLOWED_EMAILS=

# "Forgot password?" on the sign-in page (ADR-041). Off (the default): no link, no reset pages, and
# no reset emails. On: uses EMAIL_TRANSPORT and RESEND_API_KEY above (console prints the links).
# Production needs a verified domain: Resend's test sender (onboarding@resend.dev) is refused.
PASSWORD_RESET=off
# Sender of reset emails; blank uses EMAIL_FROM.
# EMAIL_RESET_FROM="InsightfulCell <no-reply@your-domain.example>"

# Admin dashboard at /dashboard: people, usage and model spend, behind this key (asked for in a
# dialog; the browser only ever gets a short-lived signed cookie). Blank: the page does not
# exist. Set the same key as the API's ADMIN_DASHBOARD_KEY. 32+ characters: openssl rand -hex 32
ADMIN_DASHBOARD_KEY=
ADMIN_SESSION_MINUTES=30

# Optional "Continue with Google" (SETUP_MANUAL.md, part 2). Set both or neither; blank is off.
# GOOGLE_SIGN_IN=off (the default) shows the button disabled and turns Google off on the server.
GOOGLE_SIGN_IN=off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
