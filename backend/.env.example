# Copy to backend/.env (scripts/bootstrap.sh does this). Never commit the copy.
ENVIRONMENT=local
LOG_LEVEL=INFO

# The API connects as a login role that is a member of ic_app: not the table owner, no BYPASSRLS.
# `make migrate` creates ic_app_dev. In production this is a managed secret.
DATABASE_URL=postgresql+psycopg://ic_app_dev:ic_app_dev@localhost:5432/insightfulcell
# Migrations run as the table owner from a deploy step (`make migrate` sets MIGRATION_DATABASE_URL
# for the command); the running API never holds those credentials.

# Tokens are issued by the web app (Better Auth); the API only verifies them with its public keys.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=insightfulcell-api
# Run-scoped event-stream tickets (minted by the web app) use their own audience.
AUTH_EVENTS_AUDIENCE=insightfulcell-events

# Browsers open live-progress streams on the API directly; list the web app's origin(s): its
# BETTER_AUTH_URL and every AUTH_TRUSTED_ORIGINS entry (`make allow-origin` adds them).
EVENTS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage. RustFS (S3-compatible) locally; on AWS leave S3_ENDPOINT_URL unset and use an IAM role.
S3_BUCKET=insightfulcell-dev
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=devdevdev
S3_FORCE_PATH_STYLE=true
# Deleting a run or dataset removes its rows at once; its files stay in storage this many days.
# STORAGE_PURGE_AFTER_DAYS=7

# MAX_UPLOAD_BYTES=262144000
# UPLOAD_PART_BYTES=8388608

# Worker (python -m insightfulcell.worker)
# WORKER_CONCURRENCY=2
# WORKER_SCRATCH_DIR=/tmp/insightfulcell
# RUN_MAX_ATTEMPTS=3

# Language model (ADR-031, ADR-036). One provider at a time: gemini (default), openai,
# anthropic, deepseek or none. Setting LLM_PROVIDER requires that provider's key (start-up
# fails without it), and the worker checks the key and models before it takes work. Left unset
# with no key, the model is off and every run plans with the built-in rules. Only a masked
# description of the table is ever sent, never rows.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# Override the provider's default models ("strong" plans and narrates, "fast" routes and
# judges). Gemini defaults: gemini-3.5-flash-lite / gemini-3.1-flash-lite (cheap, free tier);
# gemini-3.8-flash plans better at about 2.5x the price.
# LLM_MODEL_STRONG=
# LLM_MODEL_FAST=
# LLM_RUN_INPUT_TOKEN_BUDGET=120000
# Report sections narrated at once (lower it for a provider's free tier), and the judge:
# LLM_NARRATION_CONCURRENCY=4
# LLM_JUDGE=false
# Rate limits. A free tier allows a few requests a minute and a few dozen a day (Gemini's free
# tier: 20 a day per model). Space calls to the per-minute limit; refused calls wait as long as
# the provider asks (up to the longest wait), and a quota used up for the day stops model calls
# until it resets (runs then use the built-in rules and say why).
# LLM_REQUESTS_PER_MINUTE=0
# LLM_RATE_LIMIT_WAITS=4
# LLM_MAX_RETRY_WAIT_SECONDS=60
# Prices for cost accounting, USD per million input/output tokens: {"model-id": [1.0, 5.0]}
# A model with no price is never called while the spend cap is on.
# LLM_PRICES_JSON={}

# Backup model: when the main one fails in any way (quota, rate limit, outage, bad key, unusable
# answers) the same request goes here once. Never for data the privacy check blocked, never past
# the spend cap. Needs that provider's key above (OPENAI_API_KEY for openai).
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=gpt-4o-mini

# Hard spend cap, all users together, in AUD: a call is made only if its worst-case cost still
# fits, so the total never passes it; past it, runs use the built-in rules. Costs are kept in
# USD (list prices, rounded up); set the rate at or above the real one. 0 makes no paid calls.
LLM_SPEND_CAP_AUD=4.00
LLM_USD_TO_AUD=1.60
# Optional cap per person in AUD (0: off).
LLM_USER_SPEND_CAP_AUD=0
# Tag on every spend row, to tell local tests, test deployments and the released demo apart.
LLM_USAGE_LABEL=local

# Admin dashboard (/dashboard in the web app). The same key as the web app's ADMIN_DASHBOARD_KEY;
# blank switches the admin endpoint off. 32+ random characters: openssl rand -hex 32
ADMIN_DASHBOARD_KEY=
# Optional OpenAI admin key (sk-admin-…, read-only usage) to show OpenAI's own cost figures.
OPENAI_ADMIN_KEY=
