    "/v1/uploads": {
      "post": {
        "description": "Validates the name, type and size, then returns one presigned URL per part. Replaying\nthe same request with the same ``Idempotency-Key`` returns the same upload with fresh URLs.",
        "operationId": "create_upload_v1_uploads_post",
        "parameters": [
          {
            "description": "Client-generated unique key; makes retries of this request safe.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "Client-generated unique key; makes retries of this request safe.",
              "maxLength": 200,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_\\-:.]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
